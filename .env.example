# -----------------------------
# Core environment
# -----------------------------
APP_ENV=development
APP_NAME=atlas
APP_HOST=0.0.0.0
APP_PORT=8000
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Run mode: dryrun | sandbox | live
RUN_MODE=dryrun
ALLOW_OUTBOUND_NETWORK=false

# -----------------------------
# Database / cache / search
# -----------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://atlas:CHANGE_ME@localhost:5432/atlas

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# -----------------------------
# Scheduler and workers
# -----------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
SCHEDULER_TIMEZONE=Europe/Paris
DEFAULT_POLL_CRON=0 6 * * *

# -----------------------------
# Auth / security
# -----------------------------
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30

# -----------------------------
# LLM providers (provider-agnostic)
# Keep empty if provider is not enabled.
# -----------------------------
LLM_DEFAULT_PROVIDER=anthropic
LLM_DEFAULT_MODEL=claude-3-5-sonnet-latest
LLM_FALLBACK_CHAIN=openai,mistral

LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_BASE_URL=

LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=

LLM_MISTRAL_API_KEY=
LLM_MISTRAL_BASE_URL=

# Optional local model endpoint (future)
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=

# -----------------------------
# Ingestion request policy defaults
# -----------------------------
INGEST_HTTP_TIMEOUT_SEC=30
INGEST_MAX_RETRIES=3
INGEST_BACKOFF_BASE_MS=500
INGEST_BACKOFF_MAX_MS=8000
INGEST_USER_AGENT=atlas-ingestion-bot/0.1

# -----------------------------
# Dryrun controls
# -----------------------------
DRYRUN_DATASET_PATH=./tests/fixtures/dryrun
DRYRUN_SEED=42
DRYRUN_FAKE_ITEM_COUNT=250
DRYRUN_INCLUDE_DUPLICATES=true
DRYRUN_INCLUDE_MALFORMED_ITEMS=true
DRYRUN_SIMULATED_FAILURE_RATE=0.03
DRYRUN_MIN_LATENCY_MS=20
DRYRUN_MAX_LATENCY_MS=250

# -----------------------------
# Credential store integration
# The app stores only credential references in DB.
# Actual secrets must come from env or secret manager.
# -----------------------------
CREDENTIALS_BACKEND=env
CREDENTIALS_PREFIX=ATLAS_CRED_

# Example credential refs expected in runtime environment:
# ATLAS_CRED_X_API_KEY=
# ATLAS_CRED_X_API_SECRET=
# ATLAS_CRED_X_BEARER_TOKEN=
# ATLAS_CRED_NEWS_SITE_USER=
# ATLAS_CRED_NEWS_SITE_PASS=

# -----------------------------
# Observability
# -----------------------------
LOG_LEVEL=INFO
METRICS_ENABLED=true
TRACING_ENABLED=false
