{
  # Global options kept minimal; ready for future Let's Encrypt usage.
  auto_https disable_redirects
}

http://:80 {
  redir https://{host}{uri} permanent
}

https://:443 {
  tls /certs/atlas.local.crt /certs/atlas.local.key

  @api path /api/*
  handle @api {
    uri strip_prefix /api
    reverse_proxy api:8000
  }

  handle {
    reverse_proxy web:80
  }
}
